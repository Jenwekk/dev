<Page x:Class="DerkAndresBoardingHauzManagementSystem.Core.Pages.CustomerRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:currency="clr-namespace:CurrencyTextBoxControl;assembly=CurrencyTextBox"
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:controlzEx="urn:controlzex"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DerkAndresBoardingHauzManagementSystem.Utilities"
      xmlns:properties="clr-namespace:DerkAndresBoardingHauzManagementSystem.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1050"
      Title="CustomerRegistration">

    <Page.Resources>
        <Style TargetType="hc:TextBox" BasedOn="{StaticResource TextBoxPlusBaseStyle}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
            <Setter Property="hc:InfoElement.Symbol" Value="*"/>
            <Setter Property="hc:InfoElement.Necessary" Value="True"/>
            <EventSetter Event="TextChanged" Handler="InputTextBox_TextChanged"/>
            <EventSetter Event="LostFocus" Handler="InputField_LostFocus"/>
            <EventSetter Event="GotFocus" Handler="InputField_LostFocus"/>
        </Style>

        <Style TargetType="hc:DatePicker" BasedOn="{StaticResource DatePickerPlusBaseStyle}">
            <Setter Property="hc:InfoElement.Symbol" Value="*"/>
            <Setter Property="hc:InfoElement.Necessary" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
            <EventSetter Event="SelectedDateChanged" Handler="InputDatePicker_TextChanged"/>
            <EventSetter Event="LostFocus" Handler="InputField_LostFocus"/>
        </Style>

        <Style TargetType="currency:CurrencyTextBox" BasedOn="{StaticResource TextBoxExtendBaseStyle}">
            <Setter Property="hc:InfoElement.Symbol" Value="*"/>
            <Setter Property="hc:InfoElement.Necessary" Value="True"/>
            <Setter Property="Culture" Value="en-PH"/>
            <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
        </Style>

        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtendBaseStyle}">
            <Setter Property="hc:InfoElement.Symbol" Value="*"/>
            <Setter Property="hc:InfoElement.Necessary" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
        </Style>

        <Style TargetType="hc:ComboBox" BasedOn="{StaticResource ComboBoxPlusBaseStyle}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="hc:InfoElement.Symbol" Value="*"/>
            <Setter Property="hc:InfoElement.Necessary" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="IsDropDownOpen" Value="True"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="IsDropDownOpen" Value="True"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="ReadyAnimation">
            <DoubleAnimation
                Storyboard.TargetName="MainProgressBar"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.5" Duration="0:0:0.5"
                AutoReverse="True" RepeatBehavior="1"/>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="2" VerticalAlignment="Center">
            <TextBlock Style="{DynamicResource TextBlockTitle}" HorizontalAlignment="Left" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0"
                       Foreground="{DynamicResource PrimaryBrush}">
                <InlineUIContainer BaselineAlignment="Center"> <icon:PackIconMaterial Kind="AccountBoxPlusOutline" Width="22" Height="22"/> </InlineUIContainer>
                <Run Text="{x:Static properties:Resources.BoarderRegistration}"/>
            </TextBlock>

            <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                <TextBlock Text="PROGRESS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,80,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ProgressBar x:Name="MainProgressBar" Margin="-70,0,10,0" BorderThickness="1" Style="{DynamicResource ProgressBarInfo}" Height="25"/>
            </UniformGrid>

        </UniformGrid>

        <hc:ScrollViewer Grid.Row="1">
            <hc:SimpleStackPanel>

                <!--#region Personal Information Section-->

                <Expander Header="{x:Static properties:Resources.PersonalInformation}" IsExpanded="True" Grid.Row="1" Margin="12,0,12,12" hc:BorderElement.CornerRadius="8" 
                  Panel.ZIndex="1" Background="{DynamicResource RegionBrush}" BorderThickness="0">
                    <Border CornerRadius="8" Margin="0,-8,0,0" Background="{DynamicResource RegionBrush}">
                        <hc:SimpleStackPanel>
                            <UniformGrid Columns="3" VerticalAlignment="Top">
                                <hc:TextBox x:Name="IDNumField" hc:InfoElement.Title="{x:Static properties:Resources.IDNumFieldTitle}" Margin="10,20,0,0">
                                    <behaviors:Interaction.Behaviors>
                                        <controlzEx:TextBoxInputMaskBehavior InputMask="{x:Static properties:Resources.IDNumFieldDesc}" PromptChar="_" />
                                    </behaviors:Interaction.Behaviors>
                                </hc:TextBox>
                            </UniformGrid>

                            <hc:SimpleStackPanel>
                                <UniformGrid Columns="3" Margin="10,20,10,10">
                                    <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.LastNameFieldDesc}"
                                                hc:InfoElement.Title="{x:Static properties:Resources.LastNameFieldTitle}" Margin="0,0,5,0"/>

                                    <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.FirstNameFieldDesc}" 
                                                hc:InfoElement.Title="{x:Static properties:Resources.FirstNameFieldTitle}" Margin="5,0,5,0"/>

                                    <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.MiddleNameFieldDesc}"
                                                hc:InfoElement.Title="{x:Static properties:Resources.MiddleNameFieldTitle}" Margin="5,0,5,0"/>
                                </UniformGrid>
                            </hc:SimpleStackPanel>

                            <UniformGrid Columns="4" Margin="10">
                                <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.SuffixFieldDesc}" Width="192"
                                            hc:InfoElement.Title="{x:Static properties:Resources.SuffixFieldTitle}" HorizontalAlignment="Left"/>

                                <hc:DatePicker hc:InfoElement.Placeholder="{x:Static properties:Resources.BirthdateFieldDesc}" Margin="0,0,-20,0"
                                               hc:InfoElement.Title="{x:Static properties:Resources.BirthdateFieldTitle}"
                                               hc:InfoElement.Necessary="True" hc:InfoElement.Symbol="*"/>

                                <hc:ComboBox hc:TitleElement.Title="{x:Static properties:Resources.SexFieldTitle}" Margin="30,0,-40,0"
                                             hc:InfoElement.Placeholder="{x:Static properties:Resources.SexFieldDesc}">
                                    <ComboBoxItem Content="{x:Static properties:Resources.Male}"/>
                                    <ComboBoxItem Content="{x:Static properties:Resources.Female}"/>
                                </hc:ComboBox>


                                <UniformGrid Rows="2" Margin="60,0,10,0"  HorizontalAlignment="Left">
                                    <hc:TextBox hc:InfoElement.Title="LGBTQ+ " Text="Test" IsEnabled="False" Focusable="False"
                                        hc:InfoElement.Necessary="True" hc:InfoElement.Symbol="*" Height="0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,-5,0,0" Background="{DynamicResource RegionBrush}">
                                        <RadioButton GroupName="rbLGBT" Content="{x:Static properties:Resources.Yes}" hc:InfoElement.Necessary="True" hc:InfoElement.Symbol="*"/>
                                        <RadioButton GroupName="rbLGBT" Content="{x:Static properties:Resources.No}" Margin="15,0,0,0" IsChecked="True"/>
                                    </StackPanel>
                                </UniformGrid>
                            </UniformGrid>

                            <hc:SimpleStackPanel>
                                <UniformGrid Columns="2" Margin="10,10,10,20">
                                    <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.AddressFieldDesc}"
                                                hc:InfoElement.Title="{x:Static properties:Resources.AddressFieldTitle}" Margin="0,0,-150,0"/>

                                    <hc:TextBox hc:InfoElement.Title="{x:Static properties:Resources.PersonalContactFieldTitle}" Margin="165,0,5,0">
                                        <behaviors:Interaction.Behaviors>
                                            <controlzEx:TextBoxInputMaskBehavior InputMask="{x:Static properties:Resources.GuardiansContactFieldDesc}" PromptChar="_" />
                                        </behaviors:Interaction.Behaviors>
                                    </hc:TextBox>
                                </UniformGrid>
                            </hc:SimpleStackPanel>
                        </hc:SimpleStackPanel>
                    </Border>
                </Expander>

                <!--#endregion-->


                <!--#region Contact Information Section -->

                <Expander Header="{x:Static properties:Resources.EmergencyContactInformation}" IsExpanded="True" Grid.Row="1" Margin="12,4,12,12" hc:BorderElement.CornerRadius="8"
                  Panel.ZIndex="3" Background="{DynamicResource RegionBrush}" BorderThickness="0" Visibility="Visible">
                    <Border CornerRadius="8" Margin="0,-7,0,0" Background="{DynamicResource RegionBrush}">
                        <hc:SimpleStackPanel>
                            <UniformGrid Columns="2" Margin="10,20,10,20">
                                <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.GuardiansFieldDesc}"
                                    hc:InfoElement.Title="{x:Static properties:Resources.GuardiansFieldTitle}" Margin="0,0,-150,0"/>

                                <hc:TextBox hc:InfoElement.Title="{x:Static properties:Resources.GuardiansContactFieldTitle}" Margin="160,0,0,0">
                                    <behaviors:Interaction.Behaviors>
                                        <controlzEx:TextBoxInputMaskBehavior InputMask="{x:Static properties:Resources.GuardiansContactFieldDesc}" PromptChar="_" />
                                    </behaviors:Interaction.Behaviors>
                                </hc:TextBox>

                                <hc:TextBox hc:InfoElement.Placeholder="{x:Static properties:Resources.GuardiansAddressFieldDesc}"
                                    hc:InfoElement.Title="{x:Static properties:Resources.GuardiansAddressFieldTitle}" Margin="0,10,-100,0"/>

                                <UniformGrid Columns="2" Margin="110,10,0,0">
                                    <hc:TextBox x:Name="HomeLandlineField" hc:InfoElement.Title="{x:Static properties:Resources.HomeLandlineFieldTitle}" Margin="0,0,-25,0">
                                        <behaviors:Interaction.Behaviors>
                                            <controlzEx:TextBoxInputMaskBehavior InputMask="{x:Static properties:Resources.HomeLandlineFieldDesc}" PromptChar="_" />
                                        </behaviors:Interaction.Behaviors>
                                    </hc:TextBox>

                                    <CheckBox Name="rbNoLandline" Content="{x:Static properties:Resources.NoLandline}" HorizontalAlignment="Left" Margin="35,25,0,0"
                                              Checked="NoLandline_Checked" Unchecked="NoLandline_Unchecked"/>
                                </UniformGrid>
                            </UniformGrid>
                        </hc:SimpleStackPanel>
                    </Border>
                </Expander>

                <!--#endregion-->

                <!--#region Educational Information Section -->

                <Expander Header="{x:Static properties:Resources.EducationalInformation}" IsExpanded="True" Grid.Row="1" Margin="12,4,12,12" hc:BorderElement.CornerRadius="8" 
                          Panel.ZIndex="3" Background="{DynamicResource RegionBrush}" BorderThickness="0" Visibility="Visible">
                    <Border CornerRadius="8" Margin="0,-7,0,0" Background="{DynamicResource RegionBrush}">
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20" Margin="10" Grid.ColumnSpan="2">
                                <hc:TextBox x:Name="SchoolField" hc:InfoElement.Placeholder="{x:Static properties:Resources.SchoolFieldDesc}"
                                            hc:InfoElement.Title="{x:Static properties:Resources.SchoolFieldTitle}"/>

                                <DockPanel>
                                    <hc:ComboBox x:Name="DegreeField" hc:InfoElement.Title="{x:Static properties:Resources.CourseFieldTitle}"
                                                 hc:InfoElement.Placeholder="{x:Static properties:Resources.CourseTypeFieldDesc}" Width="80"
                                                 hc:InfoElement.Necessary="True" hc:InfoElement.Symbol="*" HorizontalAlignment="Stretch" 
                                                 Background="{DynamicResource PrimaryBrush}" SelectionChanged="DegreeField_SelectionChanged">

                                        <Separator/>
                                        <ComboBoxItem Content="Strand"/>
                                        <Separator/>
                                        <ComboBoxItem Content="B of "/>
                                        <ComboBoxItem Content="BA in "/>
                                        <ComboBoxItem Content="BS in "/>
                                        <Separator/>
                                        <ComboBoxItem Content="M of "/>
                                        <ComboBoxItem Content="MS in "/>
                                        <ComboBoxItem Content="MA in "/>
                                        <Separator/>
                                        <ComboBoxItem Content="D of "/>
                                        <ComboBoxItem Content="PhD in "/>
                                        <ComboBoxItem Content="EdD in "/>
                                    </hc:ComboBox>

                                    <hc:TextBox x:Name="CourseField"  hc:InfoElement.Placeholder="{x:Static properties:Resources.CourseFieldDesc}"
                                                hc:InfoElement.Title=" " hc:InfoElement.Symbol=""/>
                                </DockPanel>
                            </hc:UniformSpacingPanel>

                            <hc:TextBox x:Name="MajorField" hc:InfoElement.Placeholder="{x:Static properties:Resources.MajorFieldDesc}"
                                        hc:InfoElement.Title="{x:Static properties:Resources.MajorFieldTitle}"
                                        VerticalAlignment="Bottom" Grid.Column="2" Margin="0,0,-40,10"/>

                            <hc:ComboBox x:Name="YearLevelField" hc:InfoElement.Placeholder="{x:Static properties:Resources.YearLevelFieldDesc}"
                                         hc:InfoElement.Title="{x:Static properties:Resources.YearLevelFieldTitle}"
                                         VerticalAlignment="Bottom" Grid.Column="3" Margin="50,0,10,10" InputMethod.InputScope="Digits" Height="55">
                                <ComboBoxItem Content="{x:Static properties:Resources.FirstYear}"/>
                                <ComboBoxItem Content="{x:Static properties:Resources.SecondYear}"/>
                                <ComboBoxItem Content="{x:Static properties:Resources.ThirdYear}"/>
                                <ComboBoxItem Content="{x:Static properties:Resources.FourthYear}"/>
                            </hc:ComboBox>
                        </Grid>
                    </Border>
                </Expander>
                
                <!--#endregion-->

                <Expander Header="{x:Static properties:Resources.RoomAssignment}" IsExpanded="True" Grid.Row="1" Margin="12,4,12,12" hc:BorderElement.CornerRadius="8" 
                          Panel.ZIndex="3" Background="{DynamicResource RegionBrush}" BorderThickness="0" Visibility="Visible">
                    <Border CornerRadius="8" Margin="0,-7,0,0" Background="{DynamicResource RegionBrush}">
                        <UniformGrid Columns="3" Margin="10,20,10,20">
                            <hc:ComboBox x:Name="FloorNumField" hc:InfoElement.Placeholder="{x:Static properties:Resources.FloorNumFieldDesc}"
                                         hc:InfoElement.Title="{x:Static properties:Resources.FloorNumFieldTitle}" Margin="5,0,5,0">
                            </hc:ComboBox>
                            
                            <hc:ComboBox x:Name="RoomNumField" hc:InfoElement.Placeholder="{x:Static properties:Resources.RoomNumFieldDesc}"
                                         hc:InfoElement.Title="{x:Static properties:Resources.RoomNumFieldTitle}" Margin="0,0,5,0">                                
                            </hc:ComboBox>

                            <hc:ComboBox x:Name="BedNumField" hc:InfoElement.Placeholder="Select Bed" hc:InfoElement.Title="Bed Number" Margin="0,0,5,0"/>
                        </UniformGrid>
                    </Border>
                </Expander>
                
                <!--#endregion-->
                
                <!--#region Payment Information Section-->
                
                <Expander Header="{x:Static properties:Resources.PaymentInformation}" IsExpanded="True" Grid.Row="1" Margin="12,4,12,12" hc:BorderElement.CornerRadius="8" 
                          Panel.ZIndex="3" Background="{DynamicResource RegionBrush}" BorderThickness="0" Visibility="Visible">
                    <Border CornerRadius="8" Margin="0,-7,0,0" Background="{DynamicResource RegionBrush}">
                        <Grid Margin="10,20,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <hc:SimpleStackPanel Margin="0,-10,-40,10">
                                <hc:UniformSpacingPanel Spacing="20" Orientation="Vertical">
                                    <hc:TextBox hc:InfoElement.Title="{x:Static properties:Resources.PaymentMethodFieldTitle}" Height="10" IsEnabled="False"
                                                Focusable="False" hc:TitleElement.TitlePlacement="Left" Background="Transparent" BorderBrush="Transparent"/>

                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="12" Margin="0,-15,0,0" Background="{DynamicResource RegionBrush}">
                                        <RadioButton x:Name="CashOptionField" Content="{x:Static properties:Resources.Cash}" GroupName="PaymentMethod"/>
                                        <RadioButton x:Name="CreditDebitOptionField" Content="{x:Static properties:Resources.CreditDebit}" GroupName="PaymentMethod"/>
                                        <RadioButton x:Name="EwalletOptionField" Content="{x:Static properties:Resources.Ewallet}" GroupName="PaymentMethod"/>
                                    </hc:UniformSpacingPanel>
                                    
                                    <currency:CurrencyTextBox x:Name="MonthlyBillField" hc:InfoElement.TitlePlacement="Left" MaximumValue="99999" MinimumValue="0"
                                                          hc:InfoElement.Title="{x:Static properties:Resources.MonthBillFieldTitleCebShort}" IsReadOnly="True"/>

                                    <hc:NumericUpDown x:Name="NumMonthsField" hc:InfoElement.TitlePlacement="Left" Minimum="0" Maximum="12" HorizontalContentAlignment="Right"
                                                      hc:InfoElement.Title="{x:Static properties:Resources.NumMonthsFieldTitle}"/>

                                    <currency:CurrencyTextBox x:Name="TotalPaymentField" hc:InfoElement.TitlePlacement="Left" MaximumValue="99999" MinimumValue="0"
                                                              hc:InfoElement.Title="{x:Static properties:Resources.TotalPaymentFieldTitle}" IsReadOnly="True" FontWeight="Bold"
                                                              Foreground="{DynamicResource PrimaryBrush}"/>
                                </hc:UniformSpacingPanel>
                            </hc:SimpleStackPanel>

                            <!--<hc:SimpleStackPanel Grid.Column="1" Margin="70,0,-70,10" VerticalAlignment="Bottom">
                                <hc:UniformSpacingPanel Spacing="20" Orientation="Vertical">
                                    <currency:CurrencyTextBox x:Name="TenderField" hc:InfoElement.TitlePlacement="Left" MaximumValue="99999" MinimumValue="0"
                                                              hc:InfoElement.Title="{x:Static properties:Resources.TenderFieldTitle}"/>

                                    <currency:CurrencyTextBox x:Name="ChangeField" hc:InfoElement.TitlePlacement="Left" MaximumValue="99999" MinimumValue="0"
                                                              hc:InfoElement.Title="{x:Static properties:Resources.ChangeFieldTitle}" IsReadOnly="True" FontWeight="Bold"
                                                              Foreground="{DynamicResource PrimaryBrush}"/>
                                </hc:UniformSpacingPanel>
                            </hc:SimpleStackPanel>-->

                            <DockPanel Grid.Column="2" Grid.ColumnSpan="2" Margin="0,-30,5,0">
                                <TextBlock Text="Cash Register" FontWeight="Bold" FontSize="20" Margin="10,0,-20,0" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <Border Background="{DynamicResource ThirdlyRegionBrush}" BorderThickness="2" CornerRadius="5" Padding="10" Margin="-80,0,10,0">
                                    <UniformGrid Columns="2">
                                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20">
                                            <currency:CurrencyTextBox x:Name="TotalAmountField" IsReadOnly="True" MaximumValue="99999" MinimumValue="0" 
                                                                      hc:InfoElement.Title="{x:Static properties:Resources.TotalPaymentFieldTitle}" FontSize="14" FontWeight="Bold" 
                                                                      Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SecondaryRegionBrush}"/>

                                            <currency:CurrencyTextBox x:Name="TenderField" MaximumValue="99999.99" MinimumValue="0"  hc:InfoElement.Title="{x:Static properties:Resources.TenderFieldTitle}" Height="55"
                                                                      FontSize="13" Background="{DynamicResource SecondaryRegionBrush}"/>

                                            <currency:CurrencyTextBox x:Name="ChangeField"  IsReadOnly="True" MaximumValue="99999.99" MinimumValue="0" Height="55"
                                                                      hc:InfoElement.Title="{x:Static properties:Resources.ChangeFieldTitle}" Foreground="{DynamicResource PrimaryBrush}"
                                                                      FontWeight="Bold" Background="{DynamicResource SecondaryRegionBrush}" FontSize="13"/>
                                        </hc:UniformSpacingPanel>

                                        <hc:UniformSpacingPanel Orientation="Vertical" Margin="30,45,10,0" Spacing="20">
                                            <Button Content="Clear" Margin="5,0" Style="{DynamicResource ButtonWarning}" Height="35" FontSize="13"/>
                                            <Button Content="Cancel" Margin="5,0" Style="{DynamicResource ButtonDanger}" Height="35" FontSize="13"/>
                                            <Button Content="Submit" Margin="5,0" Style="{DynamicResource ButtonSuccess}" Height="35" FontSize="13"/>
                                        </hc:UniformSpacingPanel>

                                        <!--<TextBlock Text="Items:" FontWeight="Bold" Margin="0,10,0,0"/>
                                        <ListBox x:Name="ItemsListBox" Height="100" Margin="0,5,0,0" 
                                                 BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" 
                                                 Background="{DynamicResource RegionBrush}">

                                            <ListBoxItem Content="Item 1 - $10.00"/>
                                            <ListBoxItem Content="Item 2 - $15.00"/>
                                        </ListBox>-->
                                    </UniformGrid>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Expander>               
            </hc:SimpleStackPanel>
        </hc:ScrollViewer>

        <controlzEx:PopupEx x:Name="CashRegister" IsOpen="True" Placement="Center" Width="500" HorizontalOffset="-200">
            <Border Background="{DynamicResource ThirdlyRegionBrush}" BorderThickness="2" CornerRadius="5" Padding="10" Margin="12">
                <hc:UniformSpacingPanel Spacing="40" Orientation="Vertical" ItemHorizontalAlignment="Stretch">
                    <TextBlock Text="CASH REGISTER" FontSize="26" Margin="0,0,0,-25" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>

                    <hc:UniformSpacingPanel Spacing="30" Orientation="Horizontal" Margin="0,0,-40,0">
                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20">
                            <currency:CurrencyTextBox x:Name="TotalAmountFieldPop" IsReadOnly="True" MaximumValue="99999" MinimumValue="0"
                                          hc:InfoElement.Title="{x:Static properties:Resources.TotalPaymentFieldTitle}" FontSize="24" FontWeight="Bold" 
                                          Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SecondaryRegionBrush}" Height="100"/>

                            <currency:CurrencyTextBox x:Name="TenderFieldPop" MaximumValue="99999.99" MinimumValue="0" 
                                          hc:InfoElement.Title="{x:Static properties:Resources.TenderFieldTitle}" Height="90"
                                          FontSize="22" Background="{DynamicResource SecondaryRegionBrush}"/>

                            <currency:CurrencyTextBox x:Name="ChangeFieldPop" IsReadOnly="True" MaximumValue="99999.99" MinimumValue="0" Height="90"
                                          hc:InfoElement.Title="{x:Static properties:Resources.ChangeFieldTitle}" Foreground="{DynamicResource PrimaryBrush}"
                                          FontWeight="Bold" Background="{DynamicResource SecondaryRegionBrush}" FontSize="22"/>

                            <hc:UniformSpacingPanel.Resources>
                                <Style TargetType="currency:CurrencyTextBox" BasedOn="{StaticResource TextBoxExtendBaseStyle}">
                                    <Setter Property="hc:InfoElement.Symbol" Value="*"/>
                                    <Setter Property="hc:InfoElement.Necessary" Value="True"/>
                                    <Setter Property="Culture" Value="en-PH"/>
                                    <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
                                    <EventSetter Event="TextChanged" Handler="CashRegister_TextChanged"/>
                                </Style>
                            </hc:UniformSpacingPanel.Resources>
                        </hc:UniformSpacingPanel>

                        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20" Margin="0,0,0,5">
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="1"/>
                                    <Button Content="2"/>
                                    <Button Content="3"/>
                                </hc:UniformSpacingPanel>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="4"/>
                                    <Button Content="5"/>
                                    <Button Content="6"/>
                                </hc:UniformSpacingPanel>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="7"/>
                                    <Button Content="8"/>
                                    <Button Content="9"/>
                                </hc:UniformSpacingPanel>
                                <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="0"/>
                                    <Button Content="{icon:Material Kind=Backspace}" Name="Backspace" Background="{DynamicResource WarningBrush}"/>
                                    <Button Content="{icon:Material Kind=CloseThick}" Name="Clear" Background="{DynamicResource DangerBrush}"/>
                                </hc:UniformSpacingPanel>

                                <hc:UniformSpacingPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                                        <Setter Property="Width" Value="50"/>
                                        <Setter Property="Height" Value="50"/>
                                        <Setter Property="FontSize" Value="20"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="hc:BorderElement.CornerRadius" Value="30"/>
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Margin" Value="5"/>
                                        <EventSetter Event="Click" Handler="NumpadButton_Click"/>
                                    </Style>
                                </hc:UniformSpacingPanel.Resources>
                            </hc:UniformSpacingPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Content="Cancel" Margin="0,0,5,0" Style="{DynamicResource ButtonDanger}" Height="35" FontSize="18" 
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="CashRegister_ClosePopUp"/>
                                <Button Content="Submit" Grid.Column="1" Style="{DynamicResource ButtonSuccess}" Height="35" FontSize="18"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </hc:UniformSpacingPanel>
                    </hc:UniformSpacingPanel>
                </hc:UniformSpacingPanel>
            </Border>
        </controlzEx:PopupEx>
    </Grid>
</Page>